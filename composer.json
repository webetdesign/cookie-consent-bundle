{
    "name": "webetdesign/cookie-consent-bundle",
    "type": "symfony-bundle",
    "description": "",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "doctrine/annotations": "^1.6",
        "doctrine/doctrine-bundle": "^1.10 || ^2.0",
        "doctrine/orm": "^2.5",
        "symfony/asset": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/templating": "^6.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "twig/twig": "^2.6 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^9.0",
        "symfony/yaml": "^7.4"
    },
    "prefer-stable": true,
    "autoload": {
        "exclude-from-classmap": [
            "/Tests/"
        ],
        "psr-4": {
            "WebEtDesign\\CookieConsentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebEtDesign\\CookieConsentBundle\\Tests\\": "/Tests"
        }
    },
    "config": {
        "sort-packages": true
    }
}
